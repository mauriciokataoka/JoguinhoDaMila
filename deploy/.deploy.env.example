# Config de deploy — copie p/ deploy/.deploy.env (gitignored) e preencha os segredos.

# ── PRIMÁRIO: rsync sobre SSH (deploy.sh) ───────────────────────────────
# SSH da Hostinger: host = domínio, porta 65002 (a 22 é firewall), user = conta.
SSH_HOST=kataoka.com.br
SSH_USER=kataokac
SSH_PORT=65002
SSH_KEY=~/.ssh/mwc_deploy
# REMOTE_PATH = pasta do app RELATIVA ao home SSH (/home/kataokac).
# Ex.: joguinhodamila → /home/kataokac/joguinhodamila/.
# Configure o subdomínio joguinhodamila.kataoka.com.br com docroot nesse caminho.
REMOTE_PATH=joguinhodamila

# ── RESERVA: FTP explícito sobre TLS (deploy-ftp.sh) ────────────────────
# Só usado se rodar deploy-ftp.sh. TLS explícito (FTP_SSL=yes) — FTP puro dá timeout.
FTP_HOST=ftp.kataoka.com.br
FTP_USER=kataokac
FTP_PASS=
FTP_PORT=21
FTP_PATH=joguinhodamila
FTP_SSL=yes
